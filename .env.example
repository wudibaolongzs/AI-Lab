# Copy to .env, configure locally, then run python -B tools/start.py.
# Existing process variables take precedence. Restart after editing.
# AI_PROVIDER: deepseek or tencent (temporary development), or agentarts (official).
# Without this variable, agentarts is used.
AI_PROVIDER=deepseek

# Upstream timeout in seconds (1-120). DeepSeek often needs 6-8 s per hint.
AI_TIMEOUT=15

# DeepSeek OpenAI-compatible Chat Completions. Temporary development mode only;
# its hints are not AgentArts acceptance evidence.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tencent OpenAI-compatible Chat Completions. Alternative temporary mode.
TENCENT_API_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
TENCENT_API_KEY=
TENCENT_MODEL=

# Retained for switching back to Huawei. No Bearer prefix in either key.
AGENTARTS_WORKFLOW_URL=
AGENTARTS_API_KEY=
# This exercise scope applies to ALL providers.
AGENTARTS_EXERCISES=average,sum,count
# Cloud protection for shared trials.
AI_HINT_PROTECTION=1
# Optional rotating application log.
AI_LOG_FILE=
